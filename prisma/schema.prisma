generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum HeroStatus {
  ACTIVE
  RETIRED
  MISSING
}

enum VillainStatus {
  AT_LARGE
  CAPTURED
}

enum DangerLevel {
  LOW
  MODERATE
  HIGH
  EXTREME
}

model Hero {
  id                Int        @id @default(autoincrement())
  rank              Int
  name              String
  heroName          String
  quirk             String
  quirkDescription  String
  bio               String
  imageUrl          String?
  agency            String?
  status            HeroStatus @default(ACTIVE)
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  notes             HeroNote[]

  @@index([rank])
}

model Villain {
  id                  Int           @id @default(autoincrement())
  name                String
  alias               String
  quirk               String
  quirkDescription    String
  bio                 String
  imageUrl            String?
  organization        String?
  bounty              Int
  dangerLevel         DangerLevel   @default(MODERATE)
  status              VillainStatus @default(AT_LARGE)
  lastKnownLocation   String?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  notes               VillainNote[]

  @@index([bounty])
}

model Npc {
  id                Int      @id @default(autoincrement())
  name              String
  role              String
  quirk             String?
  quirkDescription  String?
  bio               String
  imageUrl          String?
  location          String?
  important         Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  notes             NpcNote[]

  @@index([important])
}

model User {
  id           Int          @id @default(autoincrement())
  email        String       @unique
  passwordHash String
  createdAt    DateTime     @default(now())
  heroNotes    HeroNote[]
  villainNotes VillainNote[]
  npcNotes     NpcNote[]
}

model HeroNote {
  id        Int      @id @default(autoincrement())
  content   String
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  heroId    Int
  hero      Hero     @relation(fields: [heroId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, heroId])
}

model VillainNote {
  id        Int      @id @default(autoincrement())
  content   String
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  villainId Int
  villain   Villain  @relation(fields: [villainId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, villainId])
}

model NpcNote {
  id        Int      @id @default(autoincrement())
  content   String
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  npcId     Int
  npc       Npc      @relation(fields: [npcId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, npcId])
}
